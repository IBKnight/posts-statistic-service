{
  "uid": "posts-statistic-service",
  "title": "posts-statistic-service",
  "tags": ["posts-statistic-service"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Kafka consumer lag",
      "description": "post_stats_kafka_lag — records behind the partition's high watermark. Drives /readyz. Sustained growth above lag_threshold means a shard is falling behind.",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1000 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "post_stats_kafka_lag",
          "legendFormat": "shard {{shard}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Time since last successful backup",
      "description": "time() - post_stats_last_backup_unix_seconds. The most important operability signal — alert when this exceeds a few multiples of snapshot.backup_interval (default 1h). Catches silently-failing backups before they'd otherwise show up as a full Kafka replay on restart.",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 7200 },
              { "color": "red", "value": 10800 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "time() - post_stats_last_backup_unix_seconds",
          "legendFormat": "shard {{shard}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Events applied / sec",
      "description": "rate(post_stats_events_applied_total[1m]) — accepted traffic actually mutating shard state.",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(post_stats_events_applied_total[1m])",
          "legendFormat": "shard {{shard}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Distinct posts tracked",
      "description": "post_stats_shard_posts — number of distinct posts with state in this shard.",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "post_stats_shard_posts",
          "legendFormat": "shard {{shard}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Skipped events / sec (wrong shard)",
      "description": "rate(post_stats_events_skipped_total[5m]) — events consumed that don't belong to this shard. Any sustained non-zero rate means the producer's partitioning contract is being violated and should page.",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.001 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(post_stats_events_skipped_total[5m])",
          "legendFormat": "shard {{shard}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Duplicate events / sec",
      "description": "rate(post_stats_events_duplicate_total[5m]) — EventIDs seen more than once (producer retries, at-least-once redelivery). Occasional non-zero is expected; a sudden spike is worth investigating on the producer side.",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(post_stats_events_duplicate_total[5m])",
          "legendFormat": "shard {{shard}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Malformed (failed to parse) events / sec",
      "description": "rate(post_stats_events_failed_total[5m]) — records that failed to parse as a valid event.",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(post_stats_events_failed_total[5m])",
          "legendFormat": "shard {{shard}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Last backup upload duration",
      "description": "post_stats_last_backup_duration_seconds — how long the last successful MinIO backup upload took.",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "post_stats_last_backup_duration_seconds",
          "legendFormat": "shard {{shard}}"
        }
      ]
    }
  ]
}
